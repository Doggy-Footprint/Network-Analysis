+def assert_skipped_delta(result, reason):
+    assert result == skipped(reason)
+    cur, base = mixed_pair()
+    delta = compute(cur, base, result)
+    assert delta['renames'] == skipped(reason)
+    assert without_renames(delta) == without_renames(wire(ref_delta(cur, base)))
