+@pytest.mark.parametrize('moves', [['a'], ['a', 'd']], ids=['one-rename', 'two-renames'])
+def test_V09_EP1_C18_rename_after_baseline_is_applied_and_reports_nothing(tmp_path, moves):
+    root = tmp_path / 'repo'
