{
  "schema": "scenarios.v1",
  "scenarios": [
    {
      "id": "articles-pagination",
      "task": "Add a pagination limit to the article listing repository query.",
      "targets": ["app/db/repositories/articles.py#ArticlesRepository"],
      "seed_queries": [
        {"term": "/articles", "surface": "path"},
        {"term": "pagination", "surface": "content"}
      ]
    },
    {
      "id": "jwt-expiry",
      "task": "Change how long an issued access token stays valid.",
      "targets": ["app/services/jwt.py"]
    },
    {
      "id": "comment-deletion",
      "task": "Return a 404 instead of a 403 when deleting a comment that does not exist.",
      "targets": [
        "app/db/repositories/comments.py#CommentsRepository",
        "app/api/routes/comments.py"
      ]
    }
  ]
}
